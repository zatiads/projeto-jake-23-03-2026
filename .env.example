# ── Jake OS (Flask SPA — porta 5050) ─────────────────────────────────────────
ADMIN_EMAIL=admin@jakeos.local
ADMIN_PASSWORD=Jake@2024!
SESSION_SECRET=                        # gerado automaticamente se vazio
PORT=5050
OPEN_BROWSER=false
FLASK_DEBUG=false

# ── APIs de IA ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                     # Claude (copy, análise, Social Brief)
OPENAI_API_KEY=                        # GPT-4o (chat Jake), Whisper (voz), DALL-E 3
REPLICATE_API_TOKEN=                   # Flux 1.1 Pro (geração de imagens)
GROQ_API_KEY=                          # Groq (fallback rápido, opcional)
GOOGLE_API_KEY=                        # Google Gemini (opcional)

# ── Meta Ads ─────────────────────────────────────────────────────────────────
META_TOKEN_PILOTI=                     # Token de acesso longo — agência Piloti
META_TOKEN_VIELIFE=                    # Token de acesso longo — agência Vielife
META_ACCESS_TOKEN=                     # Token genérico (fallback)
META_AD_ACCOUNT_ID=                    # ex: act_360347436292903
META_APP_ID=
META_APP_SECRET=
META_ALERTA_SALDO_LIMITE=150           # Alerta de saldo abaixo de R$

# ── Banco de dados ────────────────────────────────────────────────────────────
DATABASE_URL=                          # Neon PostgreSQL connection string

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=                    # Bot principal (jake_telegram.py)
TELEGRAM_TOKEN_PESSOAL=               # Bot pessoal (jake_pessoal.py)
TELEGRAM_TOKEN_VIAGEM=                # Bot viagem (jake_viagem.py)
TELEGRAM_ALERT_CHAT_ID=               # Chat ID para alertas
AUTHORIZED_ID=                         # ID alternativo para alertas

# ── WhatsApp (Evolution API) ──────────────────────────────────────────────────
WA_INSTANCE=                           # Nome da instância no Evolution
EVOLUTION_BASE_URL=http://localhost:8081
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
WA_AUTHORIZED_JID=                     # JID @lid do número autorizado
WA_AUTHORIZED_NUMBER=                  # Número autorizado (5535988550954)
WA_GRUPOS_JSON=                        # Path para config/wa_grupos.json

# ── Integrações externas ──────────────────────────────────────────────────────
SURGE_TOKEN=                           # Surge.sh (Social Brief — opcional)
SURGE_URL=piloti-brief.surge.sh
VERCEL_TOKEN=                          # Deploy Vercel (Site Architect — opcional)
JAKE_OS_URL=http://localhost:5050      # URL pública do Jake OS (para bots)
